# Dependencies
node_modules/

# Runtime database — your accumulated price history + imported inventory.
# Recreated by the app; never commit it or its write-ahead log.
data/prices.db
data/prices.db-shm
data/prices.db-wal

# Tooling-private files (logs, notes, ids)
.freebuff/

# Extracted CA root from the deployed Caddy (internal CA — trust this on
# clients, never commit it; regenerate by pulling from the server volume)
gw1-ca-root.crt

# OS / editor junk
.DS_Store
*.swp

# Obsidian: the vault config (theme, plugins, graph, snippets) IS committed
# on purpose, so cloning the repo and opening it in Obsidian gives everyone
# the same view — see docs/OBSIDIAN-VIEW.md. workspace.json is the one file
# excluded: it is per-session UI state (which tabs were open, pane sizes)
# that would otherwise churn on every commit and carries no shared meaning.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
