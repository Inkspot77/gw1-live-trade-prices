# GW1 Live Trade Prices — systemd unit
#
# Install:
#   sudo cp deploy/gw1-prices.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now gw1-prices
#
# Adjust User, WorkingDirectory and the --host/--watch flags to match your box.

[Unit]
Description=GW1 Live Trade Prices dashboard
Documentation=file:///opt/gw1-prices/README.md
# Needs outbound HTTPS for the price sources.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gw1
Group=gw1
WorkingDirectory=/opt/gw1-prices

# --host 0.0.0.0 exposes the dashboard to the LAN. The app has NO
# authentication unless AUTH_USER/AUTH_PASS below are both set, and its POST
# endpoints change stored state — so bind beyond loopback only on a network
# you trust, or turn auth on, or both. To keep it private instead, drop the
# flag (it binds 127.0.0.1 by default) and reach it over an SSH tunnel:
#     ssh -N -L 8787:127.0.0.1:8787 gw1-server
ExecStart=/usr/bin/node bin/gw1-prices.mjs --host 0.0.0.0 --port 8787 --watch /srv/gw1-sync/inventories

# Basic Auth for the app itself — a lighter alternative to running Caddy on
# this box (see deploy/DEPLOY.md #7). Uncomment both, or neither: half-set
# credentials make the process refuse to start rather than run unprotected.
# Environment= would put the password in `systemctl show`/the unit file
# itself; EnvironmentFile keeps it in a separate, root-only-readable file:
#     install -m 600 /dev/null /etc/gw1-prices.env
#     printf 'AUTH_USER=alan\nAUTH_PASS=<something long and unique>\n' \
#       | tee /etc/gw1-prices.env >/dev/null
# EnvironmentFile=/etc/gw1-prices.env
#
# Remember: Basic Auth alone is base64, not encryption — it is only safe to
# rely on over a transport that is already encrypted (an SSH tunnel, a
# Tailscale/WireGuard link) or paired with the TLS-terminating Caddy setup.

Restart=always
RestartSec=5
# Upstream sources go down; do not let systemd give up on the service for it.
StartLimitIntervalSec=0

StandardOutput=journal
StandardError=journal
SyslogIdentifier=gw1-prices

# Hardening. The service only needs to read its own directory, write its
# database, and read the synced inventory folder.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/gw1-prices/data
ReadOnlyPaths=/srv/gw1-sync
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
